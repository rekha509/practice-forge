# Copy to .env and fill in. .env is gitignored — never commit real secrets.

ANTHROPIC_API_KEY=

DATABASE_URL=postgresql+psycopg://practice_forge:practice_forge@localhost:5432/practice_forge
REDIS_URL=redis://localhost:6379/0

# Docker socket the worker uses to spawn sandbox containers.
DOCKER_HOST=

# docker-compose.yml volume entry for sandbox-runner's docker.sock access.
# Linux/macOS: leave unset, the compose default is correct.
# Windows + Docker Desktop: DOCKER_SOCKET_MOUNT=//./pipe/docker_engine://./pipe/docker_engine
DOCKER_SOCKET_MOUNT=

SANDBOX_MEM_LIMIT_MB=2048
SANDBOX_CPU_SECONDS_PART_A=15
SANDBOX_CPU_SECONDS_PART_B=15

ENVIRONMENT=development
LOG_LEVEL=INFO
